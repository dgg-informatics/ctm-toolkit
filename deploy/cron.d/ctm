# /etc/cron.d/ctm — tracked here so a schedule change goes through review.
# Install: sudo cp deploy/cron.d/ctm /etc/cron.d/ctm, then add a MAILTO= line
# with the alert address (not committed). Logging is handled by CTM_LOG_ENV=prod
# in the env file: a clean run mails nothing, so mail means something broke.
CTM_ENV_FILE=/etc/ctm/.env
PATH=/opt/ctm/ctm-toolkit/.venv/bin:/usr/bin:/bin

# m h dom mon dow  user       command
# Weekly trial run: pull, diff, AI annotation, merge into 06, filter into 07.
0 7 * * MON        dgg-mipro  ctm-pipeline --end 07_filtered_trials
# Nightly match against 07 and the latest patients.
0 1 * * *          dgg-mipro  flock -n /var/lib/ctm/matches/.ctm-match.lock ctm-match
