.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/
.env

# MatchMiner Mongo credentials — created locally per the README, never commit
SECRETS_JSON.json

# data/real/ — real patient data, never commit (HIPAA)
data/real/*
!data/real/.gitkeep

# data/dump/ — scratch/misc files, not tracked
data/dump/*
!data/dump/.gitkeep

# data/raw/ — patient workbooks are PHI. Deny every .xlsx by default and
# allowlist only the blank templates, so a new patient file is never exposed
# by having been named something the ignore rules did not anticipate.
data/raw/*.xlsx
!data/raw/patient_data_template.xlsx
!data/raw/west_trial_template.xlsx
!data/raw/sparrow_trials_raw.xlsx
data/raw/~$*
!data/raw/.gitkeep
data/mock/*
!data/mock/.gitkeep

# output/ — generated preview artifacts, never commit
output/*
!output/.gitkeep

# superpowers
docs/superpowers/*

# general docs not used
docs/state-of-ctm.md

.DS_Store
**/.DS_Store
*.code-workspace