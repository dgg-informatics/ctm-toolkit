.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/
.env

# hidden modules
ai.py

# data/real/ — real patient data, never commit (HIPAA)
data/real/*
!data/real/.gitkeep

# data/dump/ — scratch/misc files, not tracked
data/dump/*
!data/dump/.gitkeep

# data/raw/ — most files committed; xlsx contains patient data, never commit
data/raw/patient_data_template.xlsx
data/raw/~$*
!data/raw/.gitkeep
data/mock/*
!data/mock/.gitkeep

# output/ — generated preview artifacts, never commit
# output/

# superpowers
docs/superpowers/*

# general docs not used
docs/state-of-ctm.md

.DS_Store
**/.DS_Store
*.code-workspace