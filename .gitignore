.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/
.env

# MatchMiner Mongo credentials — created locally per the README, never commit
SECRETS_JSON.json

# data/real/ — real patient data, never commit (HIPAA)
data/real/*
!data/real/.gitkeep

# data/dump/ — scratch/misc files, not tracked
data/dump/*
!data/dump/.gitkeep

# data/ holds nothing tracked any more — the committed reference workbook is
# tests/fixtures/test-pt-data-v0.0.1.xlsx. Everything here is a local working
# copy, and patient workbooks are PHI, so deny the whole tree by default.
data/raw/*
data/mock/*

# scripts/make_template.py writes a blank workbook into the working directory;
# once filled in it is PHI, so it is never committable.
/patient_data_template.xlsx

# output/ — generated preview artifacts, never commit
output/*
!output/.gitkeep

# superpowers
docs/superpowers/*

# general docs not used
docs/state-of-ctm.md

.DS_Store
**/.DS_Store
*.code-workspace