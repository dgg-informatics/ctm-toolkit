.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
.pytest_cache/
.env

# MatchMiner Mongo credentials — created locally per the README, never commit
SECRETS_JSON.json

# data/ is gone — mock data lives in tests/fixtures/. Kept as a one-line guard so
# that if the folder is ever recreated as local scratch, a patient workbook in it
# cannot be committed.
data/

# scripts/make_template.py writes a blank workbook into the working directory;
# once filled in it is PHI, so it is never committable.
/patient_data_template.xlsx

# output/ — generated preview artifacts, never commit
output/*
!output/.gitkeep

# superpowers
docs/superpowers/*

# general docs not used
docs/state-of-ctm.md

.DS_Store
**/.DS_Store
*.code-workspace