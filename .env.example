# Copy to .env and fill in. Required by the LLM-assisted curation steps:
#   ctm-ctml
#   ctm-mm trials-curate
#   ctm-mm trials-confidence-split --recover-diagnosis
# Install those extras with: uv pip install 'ctm-toolkit[llm]'

# UMGPT (U-M's OpenAI-compatible gateway). Both are required — the CLIs fail
# fast with a clear error if either is missing.
UMGPT_API_KEY=
UMGPT_BASE_URL=

# Optional; defaults to gpt-4o when unset.
UMGPT_MODEL=gpt-4o


# ---------------------------------------------------------------------------
# MongoDB. Required by the steps that store their output in Mongo:
#   ctm-mm trials-diff
# Install with: uv pip install 'ctm-toolkit[db]'
#
# Note this is CTM's OWN MongoDB connection. It is NOT the same as
# MatchMiner's credentials, which matchengine still reads from
# SECRETS_JSON.json at the repo root (gitignored) — see the README's
# "MatchMiner Preparation and Running" section.
# ---------------------------------------------------------------------------

# All three required; the CLI fails fast naming whichever is missing.
MONGO_HOST=localhost
MONGO_PORT=27018

# This run's database. One database per run gives structural isolation, so this
# changes every run — or pass --db NAME to override it without editing .env.
MONGO_DBNAME=2026-08-17_dev

# The master trial list's database. Deliberately NOT per-run: the master is a
# rolling current-state artifact, so it has a fixed address. Reading it out of
# MONGO_DBNAME would query a database that is empty at the start of every run.
# No default — required only when trials-diff is run without --master.
MONGO_MASTER_DBNAME=ctm_master

# Optional; defaults to 06_master_trials when unset.
MONGO_MASTER_COLLECTION=06_master_trials
